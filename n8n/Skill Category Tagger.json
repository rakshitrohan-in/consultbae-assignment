      "parameters": {
        "jsCode": "const rows = $input.all().filter(i => i.json && Object.keys(i.json).length > 0);\nconst rec = $('Build Record').item.json;\nconst target = String(rec.full_name || '').trim().toLowerCase();\nconst match = rows.find(r => String(r.json.full_name || '').trim().toLowerCase() === target);\nconst maxId = rows.reduce((m, r) => {\n  const n = parseInt(r.json.person_id, 10);\n  return Number.isFinite(n) && n > m ? n : m;\n}, 0);\nreturn [{\n  json: {\n    person_id: match ? match.json.person_id : maxId + 1,\n    full_name: rec.full_name,\n    email: rec.email,\n    phone: rec.phone,\n    city: rec.city,\n    skills: rec.skills,\n    skill_category: rec.skill_category,\n    tagged_at: rec.tagged_at,\n    matched: !!match,\n    row_number: match ? match.json.row_number : null,\n  },\n}];"
      },
