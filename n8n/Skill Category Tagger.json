      "parameters": {
        "jsCode": "const raw = ($json.output && $json.output[0] && $json.output[0].content && $json.output[0].content[0] && $json.output[0].content[0].text) || '';\nconst cat = String(raw).trim().toLowerCase();\nconst allowed = ['automation-heavy', 'web dev', 'data', 'other'];\nconst category = allowed.includes(cat) ? cat : 'other';\nconst trig = $('Skill Category Tagger').item.json;\nreturn [{\n  json: {\n    full_name: trig.Name,\n    email: trig.Email || '',\n    phone: trig.Phone || '',\n    city: trig.City || '',\n    skills: trig.Skills,\n    skill_category: category,\n    tagged_at: new Date().toISOString(),\n  },\n}];"
      },
